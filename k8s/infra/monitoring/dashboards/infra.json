{
 "uid": "raas-infra",
 "title": "RaaS Infra",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Exporter up",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=~\"kafka|redis|postgres|mongodb\"}",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Kafka consumer group lag",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag)",
     "legendFormat": "{{consumergroup}} {{topic}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Kafka messages in per topic",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset[5m]))",
     "legendFormat": "{{topic}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Redis memory",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "redis_memory_used_bytes",
     "legendFormat": "used"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Redis clients and ops",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "redis_connected_clients",
     "legendFormat": "clients"
    },
    {
     "refId": "B",
     "expr": "rate(redis_commands_processed_total[5m])",
     "legendFormat": "ops/s"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Postgres connections",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (datname) (pg_stat_activity_count)",
     "legendFormat": "{{datname}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Postgres commits/s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (datname) (rate(pg_stat_database_xact_commit[5m]))",
     "legendFormat": "{{datname}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "MongoDB connections",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "mongodb_connections{state=\"current\"}",
     "legendFormat": "current"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "MongoDB opcounters",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (legacy_op_type) (rate(mongodb_op_counters_total[5m]))",
     "legendFormat": "{{legacy_op_type}}"
    }
   ]
  }
 ],
 "tags": [
  "raas"
 ]
}